# ─── PostgreSQL (Prisma) ─────────────────────────────────────────────────────
# Get a free DB from https://neon.tech or https://supabase.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/globalbridge

# ─── MongoDB (Mongoose / Catalog) ────────────────────────────────────────────
# Get a free cluster from https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/globalbridge_catalog

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-strong-random-secret-at-least-32-chars

# Your production domain (no trailing slash)
BETTER_AUTH_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ─── OAuth Providers (optional — only needed for social login) ────────────────
# Google: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
