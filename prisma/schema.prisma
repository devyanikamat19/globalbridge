generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model University {
  id             String        @id @default(cuid())
  name           String
  country        String
  city           String
  ranking        Int?
  tuition        Int?
  acceptanceRate Float?
  image          String?
  overview       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // 1-to-many relationship
  reviews        Review[]
  applications   Application[]
}

model Review {
  id           String     @id @default(cuid())
  author       String
  program      String
  rating       Int
  quote        String
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}

model Application {
  id           String     @id @default(cuid())
  program      String
  status       String     @default("Draft") // Draft, Submitted, Interview, Offer, Rejected
  deadline     String?
  progress     Int        @default(10)
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // 1-to-many relationship with AuditLog for transactional auditing
  auditLogs    AuditLog[]
}

model AuditLog {
  id            String      @id @default(cuid())
  action        String      // e.g. "STATUS_CHANGE", "PROGRESS_UPDATE"
  previousValue String?
  newValue      String
  timestamp     DateTime    @default(now())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

// ==========================================
// BETTER AUTH MODELS (Experiment 7)
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user") // "admin" | "user" | "guest" (Used in Exp 8)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String    // "google" | "github" | "credential"
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

